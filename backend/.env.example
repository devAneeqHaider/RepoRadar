# Copy to .env and fill in. Never commit .env.
SECRET_KEY=django-insecure-change-me-before-deploy
DEBUG=True
ALLOWED_HOSTS=*

# Postgres connection string used by Django.
DATABASE_URL=postgres://reporadar:reporadar@localhost:5432/reporadar

# Redis URL used by Celery as broker (and result backend).
CELERY_BROKER_URL=redis://localhost:6379/0

# Optional — enables AI onboarding guides + AI smell explanations.
# Free key: https://aistudio.google.com/ ("Get API key").
# When missing, RepoRadar degrades gracefully to factual guides and the
# detectors' static suggestions. Nothing crashes.
GEMINI_API_KEY=

# Optional — override the Gemini model (default: gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash
