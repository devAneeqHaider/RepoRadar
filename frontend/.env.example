# ---------------------------------------------------------------------------
# RepoRadar frontend environment variables
# ---------------------------------------------------------------------------
# VITE_API_URL is used as the base URL prefix for backend API calls.
# - Leave UNSET (or empty) during `npm run dev`: the client calls relative
#   "/api/..." paths and the Vite dev server proxies them to
#   http://localhost:8000 (see vite.config.js), so no CORS is needed.
# - Set it in production when the frontend is served separately from the
#   backend, e.g.:
#   VITE_API_URL=https://api.example.com
# NOTE: Vite only reads .env at build/dev-server start; restart after changes.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
